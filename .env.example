# Robinhood Chain public RPC (rate limited). Swap for an Alchemy/QuickNode URL in production.
GREENWOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Blockscout instance for the chain
GREENWOOD_BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
# Where studio-reported economy submissions are stored (JSON files)
GREENWOOD_DATA_DIR=./data
# Bearer token required on POST /api/v1/games/:id/economy. Leave empty to disable ingest.
GREENWOOD_INGEST_TOKEN=
# Public site URL, used for canonical links and OpenAPI servers
NEXT_PUBLIC_SITE_URL=http://localhost:3000
